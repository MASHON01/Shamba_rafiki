###############################################################################
# APPLICATION
###############################################################################

APP_NAME=Shamba Rafiki Backend
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

###############################################################################
# API
###############################################################################

API_HOST=0.0.0.0
API_PORT=8000

###############################################################################
# LOGGING
###############################################################################

LOG_LEVEL=INFO
LOG_FORMAT=console

###############################################################################
# LLM
###############################################################################

LLM_PROVIDER=llama_cpp
LLM_SERVER_URL=http://localhost:8080

MODEL_PATH=models/llama.gguf
MODEL_CONTEXT_SIZE=4096
MODEL_THREADS=8

# Which registered GGUF to run (app.model_runtime.registry). The default
# 3B Q4_K_M is chosen for RAM headroom under the 7 GB ceiling.
MODEL_ID=llama-3.2-3b-instruct-q4_k_m

# llama-server executable: a name on PATH or a full path. The server
# manager also falls back to the repo's llama.cpp build directory.
LLAMA_SERVER_BIN=llama-server

# --- Resilience: timeouts, retries, circuit breaker (Output 5) ---------------
# Split connect vs read so a dead server fails fast while a slow CPU
# generation is still allowed to finish.
LLM_CONNECT_TIMEOUT_SECONDS=5.0
LLM_READ_TIMEOUT_SECONDS=120.0
LLM_HEALTH_TIMEOUT_SECONDS=5.0
# Bounded retries for transient failures, then a breaker that stops
# hammering a server that is clearly down.
LLM_RETRY_MAX_ATTEMPTS=3
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RESET_SECONDS=30.0

# --- Response cache + warm-up (Output 8) -------------------------------------
# Exact-match cache of identical (prompt + sampling config) -> answer,
# LRU-evicted within a byte cap so it never threatens the RAM budget.
LLM_RESPONSE_CACHE_ENABLED=true
LLM_RESPONSE_CACHE_MAX_ENTRIES=256
# One tiny throwaway generation at startup so the first farmer isn't slow.
WARMUP_ON_STARTUP=true

###############################################################################
# PROMPTS (Output 3)
###############################################################################

# System-prompt version: "v1" is the baseline, "v2" the hardened candidate.
# Keep on v1 until the Output 7 eval shows v2 scores higher.
PROMPT_VERSION=v1

###############################################################################
# EMBEDDINGS
###############################################################################

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

###############################################################################
# VECTOR DATABASE
###############################################################################

VECTOR_STORE=data/vector_store
EMBEDDING_CACHE=data/embeddings

###############################################################################
# KNOWLEDGE BASE
###############################################################################

RAW_DOCUMENTS=data/raw_documents
PROCESSED_DOCUMENTS=data/processed_documents

###############################################################################
# IMAGE CLASSIFIER
###############################################################################

ONNX_MODEL=models/plant_classifier.onnx

###############################################################################
# LANGUAGE
###############################################################################

DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,sw

# Inject the Swahili glossary + few-shot exemplar into the prompt for
# Swahili queries (Output 6). English prompts are unaffected.
SWAHILI_PROMPT_ENRICH=true

###############################################################################
# RETRIEVAL
###############################################################################

TOP_K=5
MAX_CONTEXT_CHUNKS=5
# Cosine floor for relevance. Tuned to the real multilingual-MiniLM embedder:
# relevant passages score ~0.53-0.58, so 0.60 was too strict. Use
# scripts/probe_retrieval.py "<a question>" to re-tune for your own corpus.
SIMILARITY_THRESHOLD=0.45

###############################################################################
# RESPONSE
###############################################################################

ENABLE_VERIFICATION=true
ENABLE_CONFIDENCE_SCORING=true

###############################################################################
# PATHS
###############################################################################

LOG_DIRECTORY=logs
MODEL_DIRECTORY=models
DATA_DIRECTORY=data